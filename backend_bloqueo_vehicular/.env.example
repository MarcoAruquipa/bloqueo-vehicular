# Puerto del servidor (Northflank usa 8080)
PORT=8080

# Credenciales de la base de datos MySQL (addon de Northflank)
DB_HOST=primary.ur-proyecto.addon.code.run
DB_PORT=3306
DB_USER=usuario_base
DB_PASSWORD=clave_base
DB_NAME=nombre_base
# Activa SSL cuando el addon lo exige (Northflank)
DB_SSL=1

# Secreto para firmar los tokens JWT (¡cambiar!)
JWT_SECRET=cambia-esta-clave-secreta

# Clave opcional que usa el ESP32 para reportar su estado
API_ESP32_KEY=
ESP32_KEY_HEADER=X-API-KEY